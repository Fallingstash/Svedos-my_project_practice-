SVEDOS_ENV=development
SVEDOSSTORAGEBACKEND=local
SVEDOS_DATA_DIR=

# Required in all modes for persistent guest identity.
GUESTCOOKIESECRET=replace-with-a-long-random-secret

# Required for AI analysis.
API_KEY=replace-with-an-OpenRouter-key

# Required when SVEDOS_ENV=production and SVEDOSSTORAGEBACKEND=supabase.
SUPABASEDBURL=postgresql://postgres:<password>@<host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASESERVICEROLE_KEY=server-side-only-service-role-key
APPBASEURL=https://<public-app-url>
